---
import { getLocale, useTranslations } from '../../i18n/utils';
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const pillars = [
  { title: t('pillars.p1.title'), desc: t('pillars.p1.desc') },
  { title: t('pillars.p2.title'), desc: t('pillars.p2.desc') },
  { title: t('pillars.p3.title'), desc: t('pillars.p3.desc') },
  { title: t('pillars.p4.title'), desc: t('pillars.p4.desc') },
];
---
<section id="sobre" class="mx-auto max-w-7xl px-4 sm:px-6 py-20 sm:py-28 scroll-mt-20">
  <div class="max-w-3xl" data-reveal>
    <p class="eyebrow">{t('pillars.kicker')}</p>
    <h2 class="mt-3 font-display text-3xl sm:text-4xl lg:text-5xl text-osso">{t('pillars.title')}</h2>
  </div>

  <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-osso/10 bg-osso/10 sm:grid-cols-2 lg:grid-cols-4">
    {pillars.map((p, i) => (
      <div class="bg-[color:var(--color-igapo)] p-6 sm:p-7" data-reveal style={`transition-delay:${i * 80}ms`}>
        <span class="font-mono text-sm text-arenito">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-4 font-display text-xl text-osso">{p.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-osso-dim">{p.desc}</p>
      </div>
    ))}
  </div>
</section>
