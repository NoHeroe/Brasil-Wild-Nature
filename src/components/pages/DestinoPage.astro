---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLocale, useTranslations, pathTo } from '../../i18n/utils';
import { destinoHero } from '../../lib/tourImages';
import { touristDestinationLd } from '../../lib/jsonld';
import { site } from '../../config/site';
import TourFiche from '../TourFiche.astro';
import Icon from '../Icon.astro';

interface Props {
  destino: 'pantanal' | 'chapada' | 'nobres';
}
const { destino } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const tt = (k: string) => t(k as any);

const all = await getCollection('tours');
let tours = all.filter((e) => e.data.locale === locale && e.data.destino === destino);
if (!tours.length) tours = all.filter((e) => e.data.locale === 'pt' && e.data.destino === destino);
tours = tours.sort((a, b) => a.data.order - b.data.order);

const hero = destinoHero[destino];
const title = tt(`destinos.${destino}.title`);
const desc = tt(`destinos.${destino}.desc`);
const intro = tt(`destino.intro.${destino}`);
const tag = tt(`destinos.${destino}.tag`);
const others = (['pantanal', 'chapada', 'nobres'] as const).filter((x) => x !== destino);
const destinationLd = touristDestinationLd({
  name: title,
  description: intro,
  url: site.url.replace(/\/$/, '') + Astro.url.pathname,
});
---
<Base title={title} description={desc} pageKey={destino} jsonLd={destinationLd}>
  <section class="relative flex min-h-[62svh] items-end overflow-hidden">
    {hero ? (
      <div class="absolute inset-0">
        <Image src={hero} alt={title} widths={[600, 900, 1400, 1900]} sizes="100vw" loading="eager"
               class="h-full w-full object-cover object-center" />
        <div class="absolute inset-0" style="background:linear-gradient(to top, var(--color-igapo) 6%, color-mix(in oklab, var(--color-igapo) 55%, transparent) 42%, transparent 78%);"></div>
      </div>
    ) : (
      <div class="absolute inset-0 flex items-center justify-center bg-barro">
        <Icon name="rosette" size={120} class="text-arenito/20" />
      </div>
    )}
    <div class="relative z-10 mx-auto w-full max-w-5xl px-4 pb-14 pt-32 sm:px-6">
      <p class="eyebrow">{tag}</p>
      <h1 class="mt-3 font-display text-4xl text-osso sm:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-osso/90">{intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <h2 class="font-display text-2xl text-osso sm:text-3xl">{t('destino.toursTitle')}</h2>
    <div class="mt-8 space-y-8">
      {tours.map((e) => <TourFiche entry={e} fallbackImg={hero} />)}
    </div>
  </section>

  <section class="border-t border-osso/10 bg-barro">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
      <p class="eyebrow">{t('destino.otherTitle')}</p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {others.map((o) => (
          <a href={pathTo(o, locale)}
             class="group flex items-center justify-between rounded-xl border border-osso/10 bg-[color:var(--color-igapo)] p-5 transition-colors hover:border-sol">
            <span class="font-display text-xl text-osso">{tt(`destinos.${o}.title`)}</span>
            <Icon name="arrow" size={20} class="text-sol transition-transform group-hover:translate-x-1" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
